{
  "name": "plantuml-editor",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "flow": "flow",
    "flow-typed": "flow-typed install",
    "serve:app": "vue-cli-service serve",
    "serve:addon": "npm run build && node test/app.js",
    "build:app": "npm run clean:app &&  vue-cli-service build",
    "build": "npm run build:app",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "vue-cli-service lint",
    "deploy": "npm run build && npm run deploy:firebase",
    "deploy:firebase": "firebase deploy",
    "deploy:app": "npm run build:app && firebase deploy --only hosting",
    "firebase": "firebase",
    "vue-cli-service": "vue-cli-service",
    "clean:app": "rm -fr dist/",
    "clean": "npm run clean:app"
  },
  "dependencies": {
    "@atlassian/aui": "^9.4.0",
    "@atlassian/connect-module-core": "^2.1.5",
    "@babel/polyfill": "^7.12.1",
    "atlassian-connect-express": "^7.4.9",
    "atlassian-connect-js": "^5.3.37",
    "axios": "^0.21.1",
    "bootstrap": "^3.4.1",
    "clipboard": "^2.0.8",
    "core-js": "^3.16.1",
    "dexie": "^2.0.4",
    "dompurify": "^2.3.1",
    "dragscroll": "0.0.8",
    "font-awesome": "^4.7.0",
    "github-api": "^3.3.0",
    "jquery": "^3.6.0",
    "lodash": "^4.17.21",
    "marked": "^2.1.3",
    "plantuml-encoder": "^1.4.0",
    "plantuml-encoder-decoder": "^1.2.5-2",
    "print-js": "^1.6.0",
    "sqlite3": "^5.0.2",
    "vee-validate": "^2.2.15",
    "vue": "^2.6.14",
    "vue-codemirror": "^4.0.6",
    "vue-lazyload": "^1.3.3",
    "vue-loader": "^15.7.1",
    "vue-router": "^3.1.3",
    "vuex": "^3.6.2",
    "vuex-persistedstate": "^2.5.2"
  },
  "devDependencies": {
    "@babel/preset-flow": "^7.14.5",
    "@vue/cli-plugin-babel": "^4.5.13",
    "@vue/cli-plugin-e2e-cypress": "^4.5.13",
    "@vue/cli-plugin-eslint": "^4.5.13",
    "@vue/cli-plugin-unit-jest": "^4.5.13",
    "@vue/cli-service": "^4.5.13",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/test-utils": "^1.2.2",
    "atlas-connect": "^0.8.1",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.0.6",
    "cache-loader": "^4.1.0",
    "copy-webpack-plugin": "^4.6.0",
    "eslint": "^7.32.0",
    "eslint-plugin-flowtype": "4.7.0",
    "eslint-plugin-flowtype-errors": "^4.4.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-vue": "7.14.0",
    "firebase-admin": "^10.0.0",
    "firebase-functions": "^3.16.0",
    "firebase-tools": "^8.20.0",
    "flow-bin": "0.154.0",
    "flow-typed": "^3.3.1",
    "gulp": "^4.0.2",
    "http-proxy-middleware": "^2.0.3",
    "http-server": "^0.11.1",
    "local-web-server": "^2.6.1",
    "ngrok": "^4.3.0",
    "node-sass": "^4.12.0",
    "prettier": "^2.3.2",
    "sass": "^1.37.5",
    "sass-loader": "10.2.0",
    "tslint": "^6.1.3",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^4.45.0",
    "webpack-dev-middleware": "^5.3.1",
    "webpack-hot-middleware": "^2.25.1"
  },
  "babel": {
    "presets": [
      [
        "@vue/app",
        {
          "useBuiltIns": "entry"
        }
      ],
      "@babel/preset-flow"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "plugin:vue/essential",
      "@vue/prettier"
    ],
    "plugins": [
      "flowtype",
      "flowtype-errors"
    ],
    "rules": {
      "flowtype-errors/show-errors": 2,
      "flowtype-errors/show-warnings": 1,
      "flowtype/boolean-style": 2,
      "flowtype/define-flow-type": 2,
      "flowtype/no-dupe-keys": 2,
      "flowtype/no-primitive-constructor-types": 2,
      "flowtype/require-parameter-type": 2,
      "flowtype/require-return-type": 2,
      "flowtype/require-valid-file-annotation": 2,
      "flowtype/require-variable-type": 2,
      "flowtype/use-flow-type": 2
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "eslintIgnore": [
    "tests/*",
    "gulpfile.js",
    "vue.config.js"
  ],
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 180
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "vue"
    ],
    "transform": {
      "^.+\\.vue$": "vue-jest",
      ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "snapshotSerializers": [
      "jest-serializer-vue"
    ],
    "testMatch": [
      "**/tests/unit/**/*.spec.(js|jsx|ts|tsx)|**/__tests__/*.(js|jsx|ts|tsx)"
    ]
  }
}
